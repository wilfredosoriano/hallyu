# Get a free key at https://www.themoviedb.org/settings/api
# Set twice: VITE_ is bundled into the client for browse/search/detail calls,
# the unprefixed one is read server-side by the OG-card function only.
VITE_TMDB_API_KEY=your_tmdb_key_here
TMDB_API_KEY=your_tmdb_key_here

# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Optional. Defaults to openai/gpt-oss-120b.
# Groq retires models periodically — check console.groq.com/docs/models
# if ranking starts returning a 404.
GROQ_MODEL=openai/gpt-oss-120b
